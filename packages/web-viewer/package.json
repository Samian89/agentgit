{
  "name": "@agentgit/web-viewer",
  "version": "0.1.0",
  "description": "Browser-based read-only viewer for .agentgit-bundle files (drag-drop or ?bundle=<url>)",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@agentgit/ui-components": "workspace:*",
    "pako": "^2.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "*",
    "@types/pako": "^2.0.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "happy-dom": "^15.7.3",
    "rimraf": "*",
    "typescript": "*",
    "vite": "^5.3.4",
    "vitest": "^2.0.3"
  }
}
